<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171717"
    android:orientation="vertical">

    <TextView
        android:id="@+id/titre_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:padding="16dp"
        android:text="Lecteur vidéo"
        android:textColor="#ffffff"
        android:textStyle="bold" />

    <VideoView
        android:id="@+id/vue_video"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#000000" />

    <SeekBar
        android:id="@+id/seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/temps_actuel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:textColor="#ffffff" />

        <TextView
            android:id="@+id/temps_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#ffffff" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bouton_reculer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="-10s" />

        <Button
            android:id="@+id/bouton_lecture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="Play" />

        <Button
            android:id="@+id/bouton_avancer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="+10s" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bouton_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="Pause" />

        <Button
            android:id="@+id/bouton_arret"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="Arrêt" />

    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/option_repetition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#434343"
        android:padding="10dp"
        android:text="Répétition"
        android:textColor="#ffffff"
        android:layout_margin="10dp"/>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/option_ecran_allumer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#434343"
        android:text="Garder l'ecran allumé"
        android:textColor="#ffffff"
        android:padding="10dp"
        android:layout_margin="10dp"/>

</LinearLayout>