<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#171717">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titre_lecteur_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lecteur audio"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginBottom="16dp" />

        <ImageView
            android:id="@+id/image_audio"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#303030"
            android:scaleType="centerInside"
            android:contentDescription="Illustration du média audio" />

        <TextView
            android:id="@+id/titre_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Musique.mp3"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/artiste_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artiste inconnu"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:textAlignment="center"
            android:layout_marginTop="4dp" />

        <SeekBar
            android:id="@+id/seekbar_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/temps_actuel_audio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/temps_total_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bouton_reculer_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="-10s" />

            <Button
                android:id="@+id/bouton_lecture_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="Play" />

            <Button
                android:id="@+id/bouton_avancer_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="+10s" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bouton_pause_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="Pause" />

            <Button
                android:id="@+id/bouton_arret_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="Arrêt" />

        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/option_repetition_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#434343"
            android:padding="12dp"
            android:text="Répétition"
            android:textColor="#FFFFFF" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/option_ecran_allume_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#434343"
            android:padding="12dp"
            android:text="Garder l'écran allumé"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
